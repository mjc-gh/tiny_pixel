<div data-controller="dropdown"
     data-action="click@window->dropdown#hide keydown.esc->dropdown#hide"
     data-dropdown-open-value="<%= @visible ? 'true' : 'false' %>"
     class="relative flex-1">
  <button data-action="dropdown#toggle:stop"
          class="min-w-full inline-flex items-center justify-between gap-2 rounded-md border border-border bg-surface px-3 py-2 text-sm font-medium text-content-primary hover:bg-surface-hover focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-colors">
    <%= display_summary %>
    <%= heroicon "chevron-down", type: :mini, class: "h-4 w-4" %>
  </button>

  <div data-dropdown-target="menu"
       class="hidden absolute right-0 left-0 mt-2 md:left-[unset] md:min-w-96 rounded-md border border-border bg-surface shadow-lg z-50">
    <div class="p-4 space-y-4">
      <!-- Interval section -->
      <div>
        <p class="text-xs font-semibold text-content-secondary uppercase tracking-wide mb-2">Interval</p>
        <div class="space-y-2">
          <% intervals.each do |interval| %>
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="radio"
                     name="interval"
                     value="<%= interval[:value] %>"
                     <%= "checked" if selected?(interval[:value]) %>
                     data-action="change->site-dashboard#updateInterval"
                     class="w-4 h-4 text-primary border-border bg-surface cursor-pointer accent-primary">
              <span class="text-sm text-content-primary"><%= interval[:label] %></span>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Date range section -->
      <div class="pt-2 border-t border-border">
        <p class="text-xs font-semibold text-content-secondary uppercase tracking-wide mb-2">Date Range</p>
        <div class="flex items-center justify-between">
          <input type="date"
                 name="start_date"
                 value="<%= start_date_value %>"
                 class="block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-content-primary focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                 data-site-dashboard-target="startDate"
                 data-action="change->site-dashboard#updateDateRange">
          <span class="px-2 text-xs text-content-secondary">to</span>
          <input type="date"
                 name="end_date"
                 value="<%= end_date_value %>"
                 class="block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-content-primary focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                 data-site-dashboard-target="endDate"
                 data-action="change->site-dashboard#updateDateRange">
          <button class="pl-2 text-content-secondary cursor-pointer" data-action="site-dashboard#clearDateRange">
            <%= heroicon "x-mark" %>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
