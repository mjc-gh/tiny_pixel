<div class="p-4 border border-border rounded bg-surface hover:border-primary transition-colors">
  <%= link_to site_path(@site), class: "block hover:no-underline" do %>
    <h2 class="font-bold text-lg text-content-primary"><%= @site.name %></h2>
    <p class="text-sm text-content-secondary"><%= @site.property_id %></p>
    <p class="text-sm text-content-muted">Created <%= @site.created_at.strftime("%B %d, %Y") %></p>
  <% end %>
  
  <% if @stats %>
    <% if @stats[:avg_daily_pageviews] > 0 || @stats[:avg_daily_sessions] > 0 %>
      <div class="mt-4 pt-4 border-t border-border">
        <p class="text-xs text-content-muted mb-2"><%= granularity_label %></p>
        <div class="grid grid-cols-3 gap-2 mb-3">
          <div>
            <p class="text-xs text-content-muted">Pageviews</p>
            <p class="font-semibold text-content-primary"><%= @stats[:avg_daily_pageviews].round(1) %></p>
          </div>
          <div>
            <p class="text-xs text-content-muted">Sessions</p>
            <p class="font-semibold text-content-primary"><%= @stats[:avg_daily_sessions].round(1) %></p>
          </div>
          <div>
            <p class="text-xs text-content-muted">Avg Duration</p>
            <p class="font-semibold text-content-primary"><%= format_duration(@stats[:avg_daily_duration]) %></p>
          </div>
        </div>
      </div>
    <% else %>
      <div class="mt-4 pt-4 border-t border-border">
        <p class="text-xs text-content-muted">No data available</p>
      </div>
    <% end %>
  <% end %>
  
  <div class="mt-4 flex gap-2">
    <%= link_to edit_site_path(@site), title: t("common.settings"), class: "text-content-secondary hover:text-content-primary transition-colors" do %>
      <%= heroicon "cog-8-tooth", type: :outline, class: "h-5 w-5" %>
    <% end %>
    <% if helpers.current_user&.admin_for?(@site) %>
      <%= link_to site_memberships_path(@site), title: t("sites.memberships.title"), class: "text-content-secondary hover:text-content-primary transition-colors" do %>
        <%= heroicon "user-group", type: :outline, class: "h-5 w-5" %>
      <% end %>
    <% end %>
    <%= link_to site_instructions_path(@site), title: t("sites.instructions.title"), data: { turbo_frame: "modals", action: "slideover#open" }, class: "text-content-secondary hover:text-content-primary transition-colors" do %>
      <%= heroicon "code-bracket", type: :outline, class: "h-5 w-5" %>
    <% end %>
  </div>
</div>
