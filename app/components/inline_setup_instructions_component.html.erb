<div>
  <!-- Tracking snippet section -->
  <div class="mb-6" data-controller="clipboard">
    <label class="block text-sm font-medium text-content-primary mb-2"><%= t("onboarding.sites.create.snippet_label") %></label>
    <div class="bg-surface-hover border border-border rounded p-4 mb-3 font-mono text-sm overflow-x-auto text-gray-700 dark:text-gray-300" data-clipboard-target="source">
      <%= tracking_snippet %>
    </div>
    <button type="button" 
            data-action="clipboard#copy"
            data-clipboard-target="button"
            class="px-4 py-2 bg-primary text-white rounded hover:bg-primary-hover transition-colors text-sm">
      <%= t("onboarding.sites.create.copy") %>
    </button>
  </div>
</div>
