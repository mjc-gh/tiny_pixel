<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>tiny_pixel</title>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
        line-height: 1.5;
        color: #111827;
        background-color: #f9fafb;
        margin: 0;
        padding: 0;
      }

      table {
        border-collapse: collapse;
        width: 100%;
      }

      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
      }

      .logo-header {
        background-color: #f9fafb;
        padding: 32px 24px;
        text-align: center;
        border-bottom: 1px solid #e5e7eb;
      }

      .logo-svg {
        width: 60px;
        height: 60px;
        display: inline-block;
      }

      .content-wrapper {
        padding: 32px 24px;
      }

      .footer {
        background-color: #f9fafb;
        padding: 24px;
        text-align: center;
        border-top: 1px solid #e5e7eb;
        font-size: 12px;
        color: #4b5563;
      }

      h1 {
        color: #111827;
        font-size: 24px;
        font-weight: 600;
        margin: 0 0 16px 0;
        line-height: 1.3;
      }

      h2 {
        color: #111827;
        font-size: 18px;
        font-weight: 600;
        margin: 16px 0 12px 0;
        line-height: 1.4;
      }

      p {
        color: #111827;
        margin: 0 0 16px 0;
        font-size: 14px;
        line-height: 1.6;
      }

      a {
        color: #2563eb;
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .button {
        display: inline-block;
        background-color: #2563eb;
        color: #ffffff;
        padding: 12px 24px;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 500;
        margin: 16px 0;
      }

      .button:hover {
        background-color: #1d4ed8;
        text-decoration: none;
      }

      .secondary-text {
        color: #4b5563;
        font-size: 13px;
      }

      @media (prefers-color-scheme: dark) {
        body {
          background-color: #111827;
          color: #f3f4f6;
        }

        .email-container {
          background-color: #1f2937;
        }

        .logo-header {
          background-color: #111827;
          border-bottom-color: #374151;
        }

        .content-wrapper {
          background-color: #1f2937;
        }

        .footer {
          background-color: #111827;
          border-top-color: #374151;
          color: #9ca3af;
        }

        h1, h2 {
          color: #f3f4f6;
        }

        p {
          color: #f3f4f6;
        }

        .secondary-text {
          color: #9ca3af;
        }

        a {
          color: #60a5fa;
        }

        .button {
          background-color: #3b82f6;
        }

        .button:hover {
          background-color: #2563eb;
        }
      }
    </style>
  </head>

  <body>
    <table class="email-container" role="presentation">
      <tbody>
        <tr>
          <td class="logo-header">
            <svg class="logo-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
              <g stroke="#2563eb" stroke-width="1" fill="none" opacity="0.3">
                <line x1="10" y1="10" x2="90" y2="10"/>
                <line x1="10" y1="30" x2="90" y2="30"/>
                <line x1="10" y1="50" x2="90" y2="50"/>
                <line x1="10" y1="70" x2="90" y2="70"/>
                <line x1="10" y1="90" x2="90" y2="90"/>

                <line x1="10" y1="10" x2="10" y2="90"/>
                <line x1="30" y1="10" x2="30" y2="90"/>
                <line x1="50" y1="10" x2="50" y2="90"/>
                <line x1="70" y1="10" x2="70" y2="90"/>
                <line x1="90" y1="10" x2="90" y2="90"/>
              </g>

              <rect x="45" y="45" width="10" height="10" fill="#2563eb"/>
            </svg>
          </td>
        </tr>

        <tr>
          <td class="content-wrapper">
            <%= yield %>
          </td>
        </tr>

        <tr>
          <td class="footer">
            <p style="margin: 0; font-size: 12px;">
              &copy; <%= Date.current.year %> tiny_pixel. All rights reserved.
            </p>
            <p style="margin: 8px 0 0 0; font-size: 11px; color: inherit;">
              <span class="secondary-text">Privacy-friendly web analytics</span>
            </p>
          </td>
        </tr>
      </tbody>
    </table>
  </body>
</html>
