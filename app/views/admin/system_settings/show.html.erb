<div class="w-full max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-content-primary"><%= t("admin.system_settings.show.title") %></h1>
    <%= back_link %>
  </div>

  <div class="bg-surface border border-border rounded-lg p-6 sm:p-8">
    <div class="space-y-6">
      <div>
        <h2 class="text-lg font-semibold text-content-primary mb-4"><%= t("admin.system_settings.allowed_registration_domains.title") %></h2>

        <%= form_with url: admin_system_settings_allowed_registration_domains_path, method: :patch, local: true, class: "space-y-4" do |form| %>
          <div class="space-y-4">
            <div>
              <%= form.label :domains, t("admin.system_settings.allowed_registration_domains.label"), class: "block text-sm font-semibold text-content-primary mb-2" %>
              <%= form.text_area :domains, value: @allowed_registration_domains, rows: 10, class: "w-full px-3 py-2 border border-border rounded-lg bg-surface text-content-primary placeholder-content-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" %>
              <p class="text-xs text-content-muted mt-2"><%= t("admin.system_settings.allowed_registration_domains.help") %></p>
            </div>

            <div>
              <%= form.button t("common.save"), class: "px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
