<div class="w-full max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-content-primary"><%= t("admin.users.new.title") %></h1>
    <%= back_link %>
  </div>

  <div class="bg-surface border border-border rounded-lg p-6 sm:p-8">
    <%= default_form_with model: @user, url: admin_users_path, local: true do |form| %>
      <% if @user.errors.any? %>
        <div class="bg-danger-bg border border-danger-border rounded-md p-4 mb-4">
          <ul class="list-disc list-inside text-sm text-danger-text space-y-1">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-4">
        <div>
          <%= form.email_field :email %>
          <p class="text-xs text-content-muted mt-1"><%= t("admin.users.new.email_help") %></p>
        </div>

        <% if TinyPixel.email_delivery_supported? %>
          <div>
            <fieldset>
              <legend class="block text-sm font-semibold text-content-primary mb-3">
                <%= t("admin.users.new.creation_method_label") %>
              </legend>
              <div class="space-y-2">
                <label class="flex items-center gap-3">
                  <%= form.radio_button :creation_method, "password", { checked: true, name: "creation_method" } %>
                  <span class="text-sm text-content-secondary">
                    <%= t("admin.users.new.creation_method_password") %>
                  </span>
                </label>
                <label class="flex items-center gap-3">
                  <%= form.radio_button :creation_method, "invite", { name: "creation_method" } %>
                  <span class="text-sm text-content-secondary">
                    <%= t("admin.users.new.creation_method_invite") %>
                  </span>
                </label>
              </div>
            </fieldset>
          </div>
        <% end %>

        <div>
          <%= form.button t("common.save") %>
        </div>
      </div>
    <% end %>
  </div>
</div>
