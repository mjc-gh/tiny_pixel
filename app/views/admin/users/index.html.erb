<div class="flex items-center justify-between mb-6">
  <h1 class="font-bold text-2xl text-content-primary"><%= t("admin.users.index.title") %></h1>
  <%= link_to t("admin.users.index.create_new"), new_admin_user_path, class: "px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors text-sm font-medium" %>
</div>

<% if @users.any? %>
  <div class="overflow-x-auto bg-surface border border-border rounded-lg">
    <table class="min-w-full divide-y divide-border">
      <thead class="bg-surface-hover">
        <tr>
          <th class="px-6 py-3 text-left text-sm font-semibold text-content-secondary">Email</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-content-secondary">Created</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-content-secondary">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% @users.each do |user| %>
          <tr class="hover:bg-surface-hover transition-colors">
            <td class="px-6 py-4 text-sm text-content-primary"><%= link_to user.email, admin_user_path(user), class: "text-primary hover:underline" %></td>
            <td class="px-6 py-4 text-sm text-content-secondary"><%= user.created_at.strftime("%b %d, %Y") %></td>
            <td class="px-6 py-4 text-sm space-x-2 flex items-center gap-2">
              <% if TinyPixel.email_delivery_supported? && user.pending_invitation? %>
                <%= button_to admin_user_resend_invitation_path(user),
                    method: :post,
                    form: { data: { turbo_confirm: t("admin.users.index.resend_confirm") } },
                    title: t("admin.users.index.resend_invitation"),
                    class: "text-primary hover:text-primary/80 transition-colors" do %>
                  <%= heroicon "envelope", type: :outline, class: "h-4 w-4" %>
                <% end %>
              <% end %>
              <%= link_to edit_admin_user_path(user), title: "Edit", class: "text-primary hover:text-primary/80 transition-colors" do %>
                <%= heroicon "pencil", type: :outline, class: "h-4 w-4" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-content-muted"><%= t("admin.users.index.no_users") %></p>
<% end %>
