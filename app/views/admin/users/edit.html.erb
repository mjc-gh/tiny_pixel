<div class="w-full max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-content-primary"><%= t("admin.users.edit.title") %></h1>
    <%= back_link %>
  </div>

  <div class="bg-surface border border-border rounded-lg p-6 sm:p-8 space-y-6">
    <div class="space-y-2">
      <p class="text-sm font-semibold text-content-primary"><%= t("admin.users.show.user_email") %></p>
      <p class="text-sm text-content-secondary"><%= @user.email %></p>
    </div>

    <div class="border-t border-border pt-6">
      <h2 class="text-lg font-semibold text-content-primary mb-4"><%= t("admin.users.memberships.title") %></h2>

      <% if @memberships.any? %>
        <div class="space-y-3 mb-6">
          <% @memberships.each do |membership| %>
            <div class="flex items-center justify-between p-3 bg-surface-hover rounded-lg border border-border">
              <div>
                <p class="text-sm font-medium text-content-primary"><%= membership.site.name %></p>
                <p class="text-xs text-content-secondary"><%= t("sites.memberships.roles.#{membership.role}") %></p>
              </div>
              <%= form_with url: admin_user_membership_path(@user, membership), method: :delete, local: true do %>
                <button type="submit" data-turbo-confirm="<%= t("admin.users.memberships.remove_confirm") %>" title="<%= t("admin.users.memberships.remove_confirm") %>" class="text-destructive hover:text-destructive/80 transition-colors p-0 bg-none border-none cursor-pointer">
                  <%= heroicon "trash", type: :outline, class: "h-4 w-4" %>
                </button>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-content-muted mb-6"><%= t("admin.users.memberships.empty") %></p>
      <% end %>

      <%= link_to t("admin.users.memberships.add"), new_admin_user_membership_path(@user), class: "px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors text-sm font-medium" %>
    </div>

    <div class="border-t border-border pt-6 space-y-6">
      <h2 class="text-lg font-semibold text-content-primary mb-4"><%= t("admin.users.edit.actions") %></h2>

      <%= form_with model: @user, url: admin_user_path(@user), method: :patch, local: true do |form| %>
        <div class="flex gap-2">
          <%= form.hidden_field :regenerate_password, value: "true" %>
           <%= form.button t("admin.users.edit.regenerate_password"), data: { turbo_confirm: t("admin.users.edit.regenerate_confirm") }, class: "bg-secondary text-secondary-foreground py-2 px-4 rounded-md hover:bg-secondary-hover focus:outline-none focus:ring-2 focus:ring-secondary focus:ring-offset-2 font-medium" %>
        </div>
      <% end %>

       <%= form_with url: admin_user_path(@user), method: :delete, local: true do |form| %>
          <%= form.button t("admin.users.show.delete"), data: { turbo_confirm: t("admin.users.destroy.confirm") }, class: "bg-danger text-white py-2 px-4 rounded-md hover:bg-danger-hover focus:outline-none focus:ring-2 focus:ring-danger focus:ring-offset-2 font-medium" %>
       <% end %>
     </div>
  </div>
</div>
