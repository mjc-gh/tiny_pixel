<div class="flex items-center justify-between mb-6">
  <h1 class="font-bold text-2xl text-content-primary">Your Sites</h1>
  <%= link_to t("sites.index.create_new"), new_site_path, class: "px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors text-sm font-medium" %>
</div>

<% if @sites.any? %>
  <%= render GridListComponent.new do |grid| %>
    <% @sites.each do |site| %>
      <% grid.with_card do %>
        <%= render SiteCardComponent.new(site: site) %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <p class="text-content-muted">You don't have any sites yet.</p>
<% end %>
