<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="font-bold text-2xl text-content-primary"><%= t("sites.memberships.index.title") %></h1>
      <%= link_to @site.name, site_path(@site), class: "text-sm text-content-secondary mt-1" %>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to t("sites.memberships.index.invite_member"), new_site_membership_path(@site), class: "px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors text-sm font-medium" %>
    </div>
  </div>

  <% if @memberships.any? %>
    <div class="border border-border rounded-lg overflow-hidden">
      <table class="w-full">
        <thead>
          <tr class="border-b border-border bg-surface-secondary">
            <th class="px-4 py-3 text-left text-sm font-semibold text-content-primary"><%= t("sites.memberships.index.email") %></th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-content-primary"><%= t("sites.memberships.index.role") %></th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-content-primary"><%= t("sites.memberships.index.joined") %></th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-content-primary"><%= t("sites.memberships.index.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @memberships.each do |membership| %>
            <tr class="border-b border-border hover:bg-surface-secondary/50 transition-colors">
              <td class="px-4 py-3 text-sm text-content-primary"><%= membership.user.email %></td>
              <td class="px-4 py-3 text-sm text-content-secondary">
                <span class="inline-block px-2 py-1 rounded text-xs font-medium <%= membership.admin? ? 'bg-primary/10 text-primary' : 'bg-content-muted/10 text-content-muted' %>">
                  <%= t("sites.memberships.roles.#{membership.role}") %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm text-content-secondary"><%= membership.created_at.strftime("%B %d, %Y") %></td>
              <td class="px-4 py-3 text-sm space-x-2 flex items-center gap-2">
                <%= link_to edit_site_membership_path(@site, membership), title: t("sites.memberships.index.edit"), class: "text-primary hover:text-primary/80 transition-colors" do %>
                  <%= heroicon "pencil", type: :outline, class: "h-4 w-4" %>
                <% end %>
                <% if membership.user != current_user %>
                  <%= link_to site_membership_path(@site, membership), method: :delete, data: { confirm: t("sites.memberships.index.remove") }, title: t("sites.memberships.index.remove"), class: "text-destructive hover:text-destructive/80 transition-colors" do %>
                    <%= heroicon "trash", type: :outline, class: "h-4 w-4" %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="border border-border rounded-lg p-4 bg-surface text-center">
      <p class="text-content-secondary"><%= t("sites.memberships.index.empty") %></p>
    </div>
  <% end %>
</div>
