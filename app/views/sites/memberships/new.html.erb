<div class="w-full max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="font-bold text-2xl text-content-primary"><%= t("sites.memberships.new.title") %></h1>
      <p class="text-sm text-content-secondary mt-1"><%= @site.name %></p>
    </div>
    <%= back_link %>
  </div>

  <% if !TinyPixel.email_delivery_supported? %>
    <div class="mb-4 p-4 bg-warning/10 border border-warning/20 rounded-lg">
      <p class="text-sm text-content-secondary"><%= t("sites.memberships.new.no_email_warning") %></p>
    </div>
  <% end %>

  <div class="border border-border rounded-lg p-6 bg-surface">
    <%= form_with model: [:site, @membership], local: true, class: "space-y-4" do |form| %>
      <% if @membership.errors.any? %>
        <div class="p-4 bg-destructive/10 border border-destructive/20 rounded-lg">
          <h2 class="font-semibold text-destructive text-sm"><%= pluralize(@membership.errors.count, "error") %> prohibited this membership from being saved:</h2>
          <ul class="mt-2 list-disc list-inside space-y-1">
            <% @membership.errors.full_messages.each do |message| %>
              <li class="text-sm text-destructive"><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :email, t("sites.memberships.new.email_label"), class: "block text-sm font-medium text-content-primary mb-2" %>
        <%= form.email_field :email, placeholder: "user@example.com", class: "w-full px-3 py-2 border border-border rounded-lg bg-surface text-content-primary focus:outline-none focus:ring-2 focus:ring-primary" %>
        <p class="mt-1 text-xs text-content-secondary"><%= t("sites.memberships.new.email_help") %></p>
      </div>

      <div>
        <%= form.label :role, t("sites.memberships.new.role_label"), class: "block text-sm font-medium text-content-primary mb-2" %>
        <%= form.select :role, options_for_select(
          [
            [t("sites.memberships.roles.member"), "member"],
            [t("sites.memberships.roles.admin"), "admin"]
          ],
          @membership.role
        ), {},
        class: "w-full px-3 py-2 border border-border rounded-lg bg-surface text-content-primary focus:outline-none focus:ring-2 focus:ring-primary"
        %>
      </div>

      <div class="flex gap-2">
        <%= form.submit t("common.save"), class: "px-4 py-2 rounded font-medium text-sm text-surface bg-primary hover:bg-primary/90 transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
