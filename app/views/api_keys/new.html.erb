<div class="w-full max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-content-primary"><%= t("api_keys.new.title") %></h1>
    <%= back_link %>
  </div>

  <div class="bg-surface border border-border rounded-lg p-6 sm:p-8">
    <%= default_form_with model: @api_key, local: true do |form| %>
      <fieldset>
        <legend class="text-lg font-semibold text-content-primary mb-4"><%= t("api_keys.new.details") %></legend>
        <div class="space-y-4">
          <%= form.text_field :name, label: t("api_keys.new.name"), required: true, maxlength: 100 %>
          <%= form.datetime_local_field :expires_at, label: t("api_keys.new.expires_at"), include_seconds: false %>
          <p class="text-xs text-content-muted"><%= t("api_keys.new.expires_help") %></p>
          <%= form.button t("api_keys.new.submit") %>
        </div>
      </fieldset>
    <% end %>
  </div>
</div>
